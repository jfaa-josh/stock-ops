# ===== Build & deployment configuration =====
PYTHON_VERSION=3.13
PREFECT_VERSION=3.4.10


# ===== Provider credentials (optional) =====

# Live IBKR account credentials (required when running --providers ibkr_live)
TWS_USERID=__PUT_YOUR_LIVE_IBKR_USERNAME_HERE__
TWS_PASSWORD=__PUT_YOUR_LIVE_IBKR_PASSWORD_HERE__

# Paper IBKR account credentials (required when running --providers ibkr_paper)
TWS_USERID_PAPER=__PUT_YOUR_PAPER_IBKR_USERNAME_HERE__
TWS_PASSWORD_PAPER=__PUT_YOUR_PAPER_IBKR_PASSWORD_HERE__

# EODHD account credentials (required when running --providers eodhd)
EODHD_API_TOKEN=__PUT_YOUR_TOKEN_HERE__


# ===== Production deployment =====

# Domain used for nginx + certbot (public DNS name)
PRODUCTION_DOMAIN=your.production.domain

# Let's Encrypt account email for cert issuance/renewal notices
LETSENCRYPT_EMAIL=you@example.com

# How often nginx reloads to pick up renewed certs (seconds)
NGINX_RELOAD_INTERVAL_SECONDS=43200
